# ==============================================================================
# Cloud Composer CI/CD DAG Deployment Template — Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to `.env` and customize the values for your Google Cloud project:
#   cp .env.example .env
#
# All Python DAGs, deployment utilities, and shell scripts automatically load
# `.env` so you can test locally with `uv run pytest` and deploy seamlessly.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud Project & Composer Environment Settings
# ------------------------------------------------------------------------------
# Your Google Cloud Project ID
_PROJECT_ID="your-gcp-project-id"

# Primary Google Cloud region and zone for Cloud Composer & Dataproc
_REGION="europe-west1"
_ZONE="europe-west1-b"

# Relative directory containing your Airflow DAGs inside this repository
_DAGS_DIRECTORY="dags"

# Cloud Composer GCS bucket name (without the gs:// prefix)
_DAGS_BUCKET="europe-west1-composer-env-12345678-bucket"

# Cloud Build private worker pool name (optional, used in Cloud Build YAML configs)
_WORKER_POOL="composer-cicd-worker-pool"

# Subnetwork URI for internal-IP Dataproc clusters
_SUBNETWORK="projects/your-gcp-project-id/regions/europe-west1/subnetworks/default"

# Service account used by Cloud Composer and Dataproc worker nodes
_SERVICE_ACCOUNT="composer-worker-sa@your-gcp-project-id.iam.gserviceaccount.com"

# ------------------------------------------------------------------------------
# 2. Ephemeral Dataproc Cluster Hardware & Image Specifications
# ------------------------------------------------------------------------------
# Dataproc image version (Debian + Spark 3.5)
_IMAGE="2.2-debian12"

# Master and Worker Compute Engine machine types
_MASTER_MACHINE="n2-standard-4"
_WORKER_MACHINE="n2-standard-4"

# Boot disk sizes in GB for Master and Worker nodes
_MASTER_DISK_SIZE="100"
_WORKER_DISK_SIZE="200"

# Number of primary and secondary (preemptible/spot) workers
_WORKER_NUMBER="2"
_WORKER_PREEMPTIBLE_NUMBER="2"

# Maximum cluster idle time in seconds before automatic deletion (e.g., 3600 = 1 hour)
_MAX_IDLE="3600"

# Space-separated network tags attached to Dataproc VMs for firewall rules
_TAGS="allow-internal-dataproc-dev allow-ssh-from-management-zone-dev"

# ------------------------------------------------------------------------------
# 3. Airflow DAG Naming, Release & PySpark Job Configuration
# ------------------------------------------------------------------------------
# Cron expression or preset schedule for the Airflow DAG
_SCHEDULER="@daily"

# Logical pipeline goal / domain name (matches folder dags/<goal>_<release>_<lm>_<env>)
_GOAL="spark_transformations"

# Release identifier, local market, and deployment environment
_RELEASE="r2"
_LOCAL_MARKET="es"
_ENV="dev"

# Spark BigQuery Connector JAR URI
_SPARK_JAR="gs://spark-lib/bigquery/spark-bigquery-with-dependencies_2.12-0.36.1.jar"

# BigQuery dataset & table used by the retail sales Spark transformation job
BQ_DATASET="example_composer_workshop"
BQ_SOURCE_TABLE="sales_data"
BQ_OUTPUT_TABLE="daily_sales_summary_cicd"
